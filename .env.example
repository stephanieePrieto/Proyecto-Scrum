# Configuración general del servidor
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/nombre_base_datos

# Seguridad y Tokens JWT (puedes dejarlos vacíos o con cadenas de ejemplo)
JWT_SECRET=tu_secreto_jwt_aqui
JWT_REFRESH_SECRET=tu_secreto_refresh_aqui
JWT_ACCESO_MINUTOS=15
JWT_RENOVACION_MINUTOS=30
RECUPERACION_MINUTOS=30

# Control de intentos y seguridad de IP
MAX_INTENTOS_CORREO=10
MAX_INTENTOS_IP=30
BLOQUEO_MINUTOS=15
INACTIVIDAD_MINUTOS=30

# URLs y Proxy
APP_URL=https://localhost:3000
CONFIAR_PROXY=false

# Configuración HTTPS y Certificados Locales
HTTPS_ACTIVO=true
HTTPS_PUERTO=3000
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost.pem
FORZAR_HTTPS=false
CSP_SOLO_REPORTE=true

# Configuración de Correo (Modos: smtp o consola)
CORREO_MODO=smtp
CORREO_REMITENTE=ScrumFlow <no-responder@scrumflow.test>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SEGURO=true
SMTP_USUARIO=tu_correo@gmail.com
SMTP_CLAVE=tu_contraseña_de_aplicacion

# Clave de cifrado para secretos TOTP (32 bytes, base64)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=tu_clave_de_32_bytes_en_base64_aqui

# Duracion del token temporal de 2FA (minutos)
TOKEN_2FA_TEMPORAL_MINUTOS=15

# Duracion de codigos OTP por correo (minutos)
OTP_CORREO_MINUTOS=3

# Maximo de intentos fallidos de verificacion 2FA (default: 5)
MAX_INTENTOS_2FA=5

